# ========================
# LexAI — Root .gitignore
# ========================

# ── Python ──────────────────────────────
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# ── Environment Variables (SECRETS) ─────
.env
.env.*
!.env.example

# ── Vector Database (large binary files) ─
vector_db/

# ── Large Dataset Files ──────────────────
datasets/
clean_legal_dataset.json

# ── Node / Frontend ──────────────────────
node_modules/
frontend/node_modules/
frontend/react-app/node_modules/
dist/
dist-ssr/
*.local

# ── Logs ─────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor ──────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ─────────────────────────────────
*.tmp
*.bak
*.sqlite3
